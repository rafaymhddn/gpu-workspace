{
  "name": "gpu-workspace",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "gpu-workspace",
  "workspaceFolder": "/workspace",
  "remoteUser": "root",
  "features": {},
  "runServices": [
    "gpu-workspace"
  ],
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "postCreateCommand": [
    "git config --system --add safe.directory /workspace || true",
    "{",
    "  mkdir -p /root/.ssh;",
    "  cat >> /root/.zprofile <<'EOF'",
    "  if [ -z \"$SSH_AUTH_SOCK\" ]; then",
    "    RUNNING_AGENT=\"$(ps -ax | grep 'ssh-agent -s' | grep -v grep | wc -l | tr -d '[:space:]')\"",
    "    if [ \"$RUNNING_AGENT\" = \"0\" ]; then",
    "      ssh-agent -s > $HOME/.ssh/ssh-agent 2>/dev/null",
    "    fi",
    "    [ -f \"$HOME/.ssh/ssh-agent\" ] && eval \"$(cat $HOME/.ssh/ssh-agent)\" >/dev/null",
    "    ssh-add $HOME/.ssh/id_ed25519>/dev/null",
    "  fi",
    "EOF",
    "  [ -f \"$HOME/.ssh/ssh-agent\" ] && eval \"$(cat $HOME/.ssh/ssh-agent)\" >/dev/null && ssh-add $HOME/.ssh/id_ed25519>/dev/null",
    "}"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "ms-vscode-remote.remote-containers"
      ]
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "hostRequirements": {
    "gpu": true
  },
  "forwardPorts": [
    8888,
    9000,
    6006,
    7860,
    8080
  ]
}

